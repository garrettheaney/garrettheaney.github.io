<style>
  :root {
    --bg: #000;
    --fg: #fff;
    --display: "Archivo Black", Impact, "Arial Black", "Helvetica Neue", Arial, sans-serif;
    --text: "Archivo", "Helvetica Neue", Arial, sans-serif;
    --pad: clamp(1rem, 4vw, 3rem);
    --line: 6px;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--text);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--fg); text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 4px; }
  a:hover { background: var(--fg); color: var(--bg); text-decoration: none; }
  a:focus-visible { outline: 4px solid var(--fg); outline-offset: 4px; }

  main { max-width: 90rem; margin: 0 auto; border-left: var(--line) solid var(--fg); border-right: var(--line) solid var(--fg); }

  /* hero */
  header { padding: var(--pad); border-bottom: var(--line) solid var(--fg); position: relative; }
  .gator { display: block; width: clamp(12rem, 34vw, 26rem); height: auto; margin: 0 0 1.5rem; }
  h1 {
    font-family: var(--display);
    font-weight: 900; font-synthesis: none;
    font-size: clamp(3.4rem, 17vw, 14rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .roles {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.1rem, 3vw, 2.2rem);
    text-transform: uppercase;
    line-height: 1.05;
    margin: 1.5rem 0 1.25rem;
  }
  .contact { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; font-weight: 800; font-size: 1.1em; margin: 0; padding: 0; list-style: none; }
  .pdf {
    font-weight: 900;
    display: inline-block;
    margin-top: 1.5rem;
    border: 4px solid var(--fg);
    padding: 0.6rem 1.1rem;
    font-family: var(--display);
    text-transform: uppercase;
    text-decoration: none;
  }
  .pdf:hover { background: var(--fg); color: var(--bg); }

  /* sections */
  section { border-bottom: var(--line) solid var(--fg); }
  h2 {
    font-family: var(--display);
    font-weight: 900; font-synthesis: none;
    font-size: clamp(2.6rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin: 0;
    padding: var(--pad);
    border-bottom: var(--line) solid var(--fg);
  }

  .job {
    display: grid;
    grid-template-columns: minmax(8rem, 22%) 1fr;
    border-bottom: 3px solid var(--fg);
  }
  .job:last-child { border-bottom: 0; }
  .job:hover { background: var(--fg); color: var(--bg); }
  .when {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    line-height: 1;
    padding: var(--pad);
    border-right: 3px solid currentColor;
  }
  .what { padding: var(--pad); }
  h3 {
    font-family: var(--display);
    font-weight: 900; font-synthesis: none;
    font-size: clamp(1.5rem, 3.4vw, 2.8rem);
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
  }
  .where { font-weight: 800; font-size: 1.15em; margin: 0.5rem 0 1rem; text-transform: uppercase; }
  ul { margin: 0; padding: 0; list-style: none; max-width: 50rem; }
  li { padding-left: 1.4em; position: relative; margin: 0 0 0.55rem; }
  li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 0.7em; height: 0.7em; background: currentColor; }

  .block { padding: var(--pad); max-width: 60rem; font-size: 1.15em; font-weight: 600; margin: 0; }
  .block + .block { padding-top: 0; }
  .edu strong { font-family: var(--display); font-weight: 900; font-synthesis: none; text-transform: uppercase; }

  footer { font-weight: 900; padding: var(--pad); font-family: var(--display); font-size: clamp(1rem, 2vw, 1.5rem); text-transform: uppercase; }

  @media (max-width: 44rem) {
    .job { grid-template-columns: 1fr; }
    .when { border-right: 0; border-bottom: 3px solid currentColor; padding-bottom: 0.75rem; }
  }
  @media print {
    html, body { background: #000; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .pdf { display: none; }
    .job { break-inside: avoid; }
  }
</style>
